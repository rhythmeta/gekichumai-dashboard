{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./src/worker.ts",
  "name": "gekichumai-dashboard",
  "account_id": "10dabe832f43634059930effbc08f01e",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dash.rhythmeta.org",
      "custom_domain": true,
      "zone_id": "3842c59d03b6d2d937b84f679b3bdb8b",
    },
  ],
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/backups/*"],
  },
  "observability": { "enabled": false },
}
