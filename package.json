{
  "name": "rhythmeta-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:env": "node -e \"if (!process.env.NEXT_PUBLIC_BACKEND_URL) process.exit(1)\"",
    "generate:headers": "node ./scripts/generate-security-headers.mjs",
    "build": "pnpm run generate:headers && next build",
    "start": "next dev",
    "deploy": "pnpm run check:env && pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@serenity-kit/opaque": "1.1.0",
    "@simplewebauthn/browser": "^12.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.82.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "shadcn": "^4.23.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/validator": "^13.15.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wrangler": "4.145.0"
  },
  "packageManager": "pnpm@10.28.2"
}
